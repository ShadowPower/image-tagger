<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shad="clr-namespace:ShadUI;assembly=ShadUI"
             x:Class="ImageTagger.App.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ImageTagger.App/Themes/DesignTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <SimpleTheme />
        <shad:ShadTheme />
        <!-- 全局滚动条：悬浮覆盖、自动隐藏，不占布局空间、不挤压内容 -->
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="True" />
        </Style>
        <!-- 卡片内置滚动容器默认允许横向溢出（内容按无限宽度测量），导致行内控件被右边缘裁切；
             这里统一约束为视口宽度，卡片内容只允许纵向滚动 -->
        <Style Selector="shad|Card">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <!-- Interactive select controls share one readable type scale in every view. -->
        <Style Selector="ComboBox">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Application.Styles>
</Application>
